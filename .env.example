# Google Gemini API Key (Required for AI Copilot financial reasoning)
GEMINI_API_KEY="your_gemini_api_key_here"

# JWT Authentication Secrets (Required - generate secure 64-character hex strings)
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# Server Configuration
PORT=3000
NODE_ENV="development"

# --- AWS Free Tier Configuration ---
AWS_REGION="us-east-1"
USE_DYNAMODB="false" # Set to "true" to switch from local JSON to live AWS DynamoDB
DYNAMODB_USERS_TABLE="Splity_Users"
DYNAMODB_TRANSACTIONS_TABLE="Splity_Transactions"
DYNAMODB_CATEGORIES_TABLE="Splity_Categories"
DYNAMODB_BUDGETS_TABLE="Splity_Budgets"
DYNAMODB_FRIENDS_TABLE="Splity_Friends"
DYNAMODB_DEBTS_TABLE="Splity_Debts"

# S3 Receipt Storage Bucket
S3_STORAGE_BUCKET="splity-app-storage-bucket"

# Amazon Cognito Authentication (Optional - 50,000 MAU Free Tier)
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""

